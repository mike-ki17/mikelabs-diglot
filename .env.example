# SQLite (default for local development)
DATABASE_URL=file:./data/diglot.db

# Docker / production SQLite (inside the container)
# DATABASE_URL=file:/app/data/diglot.db

# JWT signing secret (use a long random string in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Astro SSR server (required in Docker so the container accepts external traffic)
# HOST=0.0.0.0
# PORT=4321
