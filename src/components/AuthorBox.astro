---
import { Image } from 'astro:assets';
import type { User } from '../db/schema';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
	lang: Lang;
	author: {
		name: string;
		bio: string | null;
		avatarUrl: string | null;
		roleName: string;
		socialLinks: User['socialLinks'];
	};
}

const { lang, author } = Astro.props;
const copy = t(lang);
const social = author.socialLinks ?? {};
const roleLabel = author.roleName === 'admin' ? copy.authorRole : author.roleName;
---

<aside class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
	<div class="flex items-start gap-4">
		{
			author.avatarUrl ? (
				<Image
					src={author.avatarUrl}
					alt={author.name}
					width={56}
					height={56}
					loading="lazy"
					class="h-14 w-14 shrink-0 rounded-full object-cover ring-2 ring-slate-100"
				/>
			) : (
				<div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-slate-200 to-blue-100 text-lg font-semibold text-slate-600">
					{author.name.charAt(0)}
				</div>
			)
		}
		<div class="min-w-0 flex-1">
			<p class="text-base font-semibold tracking-tight text-slate-900">{author.name}</p>
			<p class="text-sm text-slate-500">{roleLabel}</p>
			{
				author.bio && (
					<p class="mt-3 text-sm leading-relaxed text-slate-600">{author.bio}</p>
				)
			}
			{
				(social.github || social.twitter || social.website) && (
					<div class="mt-4 flex items-center gap-3">
						{social.github && (
							<a
								href={social.github}
								target="_blank"
								rel="noopener noreferrer"
								class="text-slate-400 transition-colors hover:text-slate-800"
								aria-label="GitHub"
							>
								<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path
										fill-rule="evenodd"
										d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
										clip-rule="evenodd"
									/>
								</svg>
							</a>
						)}
						{social.twitter && (
							<a
								href={social.twitter}
								target="_blank"
								rel="noopener noreferrer"
								class="text-slate-400 transition-colors hover:text-slate-800"
								aria-label="Twitter"
							>
								<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.227-8.26L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
								</svg>
							</a>
						)}
						{social.website && (
							<a
								href={social.website}
								target="_blank"
								rel="noopener noreferrer"
								class="text-slate-400 transition-colors hover:text-slate-800"
								aria-label="Website"
							>
								<svg
									class="h-5 w-5"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M12 21a9 9 0 100-18 9 9 0 000 18z"
									/>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 010 18M12 3a15 15 0 000 18"
									/>
								</svg>
							</a>
						)}
					</div>
				)
			}
		</div>
	</div>
</aside>
