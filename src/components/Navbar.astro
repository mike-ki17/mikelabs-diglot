---
import { Image } from 'astro:assets';
import { languages, type Lang, t } from '../i18n/ui';
import type { HreflangAlternates } from '../lib/seo';
import { getAuthUser } from '../lib/auth';

interface Props {
	lang: Lang;
	alternates?: HreflangAlternates;
}

const { lang, alternates = {} } = Astro.props;
const copy = t(lang);
const user = await getAuthUser(Astro.cookies);

function langHref(code: Lang): string {
	const absolute = alternates[code];
	if (!absolute) return `/${code}`;
	try {
		return new URL(absolute).pathname;
	} catch {
		return absolute.startsWith('/') ? absolute : `/${code}`;
	}
}
---

<header
	class="sticky top-0 z-50 border-b border-slate-200/60 bg-white/70 backdrop-blur-md"
>
	<nav class="relative mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
		<div class="flex items-center gap-2 text-sm">
			{
				(Object.keys(languages) as Lang[]).map((code) => (
					<a
						href={langHref(code)}
						class:list={[
							'rounded-full px-2.5 py-1 transition-colors hover:bg-slate-100',
							code === lang
								? 'font-semibold text-slate-900'
								: 'text-slate-500 hover:text-slate-800',
						]}
					>
						{languages[code]}
					</a>
				))
			}
		</div>

		<div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
			<a
				href={`/${lang}`}
				class="site-name text-[1.65rem] text-slate-800 transition-colors hover:text-slate-950"
				aria-label={copy.siteName}
			>
				{copy.siteName}
			</a>
		</div>

		<div class="flex items-center gap-2">
			{
				user ? (
					<div class="flex items-center gap-3">
						{user.roleName === 'admin' && (
							<a
								href="/admin"
								class="hidden rounded-full border border-slate-200 bg-white/80 px-3 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900 sm:inline"
							>
								Admin
							</a>
						)}
						<div class="flex items-center gap-2">
							{user.avatarUrl ? (
								<Image
									src={user.avatarUrl}
									alt={user.name}
									width={32}
									height={32}
									loading="lazy"
									class="h-8 w-8 rounded-full object-cover ring-2 ring-slate-100"
								/>
							) : (
								<div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-slate-200 to-blue-100 text-sm font-semibold text-slate-600">
									{user.name.charAt(0)}
								</div>
							)}
							<span class="hidden text-sm font-medium text-slate-700 sm:inline">
								{user.name}
							</span>
						</div>
						<form
							id="logout-form"
							method="POST"
							action="/api/auth/logout"
						>
							<input type="hidden" name="redirectTo" value={`/${lang}`} />
							<button
								type="submit"
								id="logout-btn"
								data-lang={lang}
								class="rounded-full border border-slate-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900"
							>
								{copy.logOut}
							</button>
						</form>
					</div>
				) : (
					<>
						<a
							href={`/${lang}/login`}
							class="rounded-full border border-slate-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900"
						>
							{copy.logIn}
						</a>
						<a
							href={`/${lang}/join`}
							class="rounded-full bg-slate-900 px-4 py-1.5 text-sm font-medium text-white transition-colors hover:bg-slate-800"
						>
							{copy.join}
						</a>
					</>
				)
			}
		</div>
	</nav>
</header>

{
	user && (
		<script>
			const form = document.getElementById('logout-form');
			const btn = document.getElementById('logout-btn');
			form?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const lang = btn?.dataset.lang || 'es';
				try {
					await fetch('/api/auth/logout', {
						method: 'POST',
						credentials: 'include',
					});
				} finally {
					window.location.href = `/${lang}`;
				}
			});
		</script>
	)
}
