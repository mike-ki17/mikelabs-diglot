---
import type { Post } from '../db/schema';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
	lang: Lang;
	post: Pick<Post, 'title' | 'slug' | 'createdAt'>;
}

const { lang, post } = Astro.props;
const copy = t(lang);
const date = post.createdAt
	? new Intl.DateTimeFormat(lang, { dateStyle: 'medium' }).format(post.createdAt)
	: null;
---

<article class="border-b border-stone-200 py-6 last:border-b-0">
	<a href={`/${lang}/blog/${post.slug}`} class="group block">
		<h2 class="text-xl font-semibold text-stone-900 group-hover:underline">
			{post.title}
		</h2>
		{date && <time class="mt-1 block text-sm text-stone-500" datetime={post.createdAt?.toISOString()}>{date}</time>}
		<span class="mt-3 inline-block text-sm font-medium text-stone-700 group-hover:underline">
			{copy.readMore} →
		</span>
	</a>
</article>
