---
import '../styles/global.css';
import type { AuthUser } from '../lib/auth';

export interface Props {
	title: string;
	user: AuthUser;
	currentPath?: string;
}

const { title, user, currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
	{ href: '/admin', label: 'Dashboard', match: (p: string) => p === '/admin' },
	{
		href: '/admin/posts',
		label: 'Posts',
		match: (p: string) => p.startsWith('/admin/posts'),
	},
	{
		href: '/admin/settings',
		label: 'Configuración',
		match: (p: string) => p.startsWith('/admin/settings'),
	},
] as const;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap"
			rel="stylesheet"
		/>
		<title>{title} · Admin</title>
	</head>
	<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
		<div class="flex min-h-screen">
			<aside
				class="fixed inset-y-0 left-0 z-40 flex w-60 flex-col bg-slate-900 text-slate-300"
			>
				<div class="border-b border-slate-800 px-5 py-5">
					<a
						href="/admin"
						class="site-name text-xl text-white transition-colors hover:text-slate-100"
					>
						Mike
					</a>
					<p class="mt-1 text-xs uppercase tracking-wide text-slate-500">
						Administración
					</p>
				</div>

				<nav class="flex flex-1 flex-col gap-1 px-3 py-4">
					{
						navItems.map((item) => {
							const active = item.match(currentPath);
							return (
								<a
									href={item.href}
									class:list={[
										'rounded-xl px-3 py-2.5 text-sm font-medium transition-colors',
										active
											? 'bg-slate-800 text-white'
											: 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-100',
									]}
								>
									{item.label}
								</a>
							);
						})
					}
				</nav>

				<div class="border-t border-slate-800 px-4 py-4">
					<p class="truncate text-sm font-medium text-slate-200">
						{user.name}
					</p>
					<p class="truncate text-xs text-slate-500">{user.email}</p>
					<div class="mt-3 flex flex-col gap-1.5">
						<a
							href="/es"
							class="rounded-full border border-slate-700 px-3 py-1.5 text-center text-xs font-medium text-slate-300 transition-colors hover:border-slate-600 hover:bg-slate-800 hover:text-white"
						>
							Ver sitio
						</a>
						<button
							type="button"
							id="admin-logout-btn"
							class="rounded-full border border-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-slate-600 hover:bg-slate-800 hover:text-white"
						>
							Cerrar sesión
						</button>
					</div>
				</div>
			</aside>

			<div class="flex min-h-screen flex-1 flex-col pl-60">
				<header
					class="sticky top-0 z-30 border-b border-slate-200/60 bg-white/80 backdrop-blur-md"
				>
					<div class="flex h-14 items-center px-6 sm:px-8">
						<h1 class="text-lg font-semibold tracking-tight text-slate-900">
							{title}
						</h1>
					</div>
				</header>
				<main class="flex-1 px-6 py-8 sm:px-8">
					<slot />
				</main>
			</div>
		</div>

		<script>
			const btn = document.getElementById('admin-logout-btn');
			btn?.addEventListener('click', async () => {
				try {
					await fetch('/api/auth/logout', {
						method: 'POST',
						credentials: 'include',
					});
				} finally {
					window.location.href = '/es/login';
				}
			});
		</script>
	</body>
</html>
