---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import SEO from '../components/SEO.astro';
import {
	canonicalFromAstro,
	type ArticleType,
	type HreflangAlternates,
} from '../lib/seo';
import { type Lang } from '../i18n/ui';

export interface Props {
	lang: Lang;
	title: string;
	description?: string;
	image?: string;
	canonicalURL?: string;
	articleType?: ArticleType;
	alternates: HreflangAlternates;
	noindex?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	lang,
	title,
	description,
	image,
	canonicalURL = canonicalFromAstro(Astro.url, Astro.site),
	articleType = 'website',
	alternates,
	noindex = false,
	jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap"
			rel="stylesheet"
		/>
		<SEO
			lang={lang}
			title={title}
			description={description}
			image={image}
			canonicalURL={canonicalURL}
			articleType={articleType}
			alternates={alternates}
			noindex={noindex}
			jsonLd={jsonLd}
		/>
	</head>
	<body class="relative flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased">
		<div
			class="pointer-events-none fixed inset-0 -z-10 overflow-hidden"
			aria-hidden="true"
		>
			<div
				class="absolute -left-32 -top-24 h-96 w-96 rounded-full bg-blue-200/30 blur-3xl"
			>
			</div>
			<div
				class="absolute -right-24 top-1/4 h-80 w-80 rounded-full bg-violet-200/25 blur-3xl"
			>
			</div>
			<div
				class="absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-sky-100/40 blur-3xl"
			>
			</div>
		</div>

		<Navbar lang={lang} alternates={alternates} />
		<main class="relative flex-1 px-4 py-10 sm:px-6">
			<slot />
		</main>
		<Footer lang={lang} alternates={alternates} />
	</body>
</html>
