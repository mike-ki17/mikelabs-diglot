---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { type Lang, t } from '../i18n/ui';

interface Props {
	lang: Lang;
	title: string;
	description?: string;
}

const { lang, title, description } = Astro.props;
const copy = t(lang);
const pageTitle = `${title} · ${copy.siteName}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{pageTitle}</title>
	</head>
	<body class="relative flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased">
		<div
			class="pointer-events-none fixed inset-0 -z-10 overflow-hidden"
			aria-hidden="true"
		>
			<div
				class="absolute -left-32 -top-24 h-96 w-96 rounded-full bg-blue-200/30 blur-3xl"
			>
			</div>
			<div
				class="absolute -right-24 top-1/4 h-80 w-80 rounded-full bg-violet-200/25 blur-3xl"
			>
			</div>
			<div
				class="absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-sky-100/40 blur-3xl"
			>
			</div>
		</div>

		<Navbar lang={lang} />
		<main class="relative flex-1 px-4 py-10 sm:px-6">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
