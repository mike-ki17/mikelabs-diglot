---
import { Image } from 'astro:assets';
import { and, asc, eq, ne } from 'drizzle-orm';
import { marked } from 'marked';
import AuthorBox from '../../../components/AuthorBox.astro';
import { db } from '../../../db';
import { comments, posts, roles, users } from '../../../db/schema';
import { isLang, type Lang, t } from '../../../i18n/ui';
import { getAuthUser } from '../../../lib/auth';
import {
	absoluteUrl,
	blogPostingJsonLd,
	canonicalFromAstro,
	excerptFromContent,
	type ArticleType,
	type HreflangAlternates,
} from '../../../lib/seo';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const { lang: langParam, slug } = Astro.params;

if (!langParam || !isLang(langParam) || !slug) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const lang = langParam;
const copy = t(lang);
const authUser = await getAuthUser(Astro.cookies);
const site = Astro.site;

const result = await db
	.select({
		id: posts.id,
		title: posts.title,
		slug: posts.slug,
		content: posts.content,
		excerpt: posts.excerpt,
		coverImageUrl: posts.coverImageUrl,
		translationGroupId: posts.translationGroupId,
		createdAt: posts.createdAt,
		updatedAt: posts.updatedAt,
		authorName: users.name,
		authorBio: users.bio,
		authorAvatarUrl: users.avatarUrl,
		authorSocialLinks: users.socialLinks,
		authorRoleName: roles.name,
	})
	.from(posts)
	.innerJoin(users, eq(posts.authorId, users.id))
	.innerJoin(roles, eq(users.roleId, roles.id))
	.where(
		and(
			eq(posts.slug, slug),
			eq(posts.language, lang),
			eq(posts.isPublished, true),
		),
	)
	.get();

if (!result) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const htmlContent = await marked.parse(result.content);
const date = result.createdAt
	? new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(result.createdAt)
	: null;

const postComments = await db
	.select({
		id: comments.id,
		content: comments.content,
		createdAt: comments.createdAt,
		name: users.name,
		avatarUrl: users.avatarUrl,
	})
	.from(comments)
	.innerJoin(users, eq(comments.userId, users.id))
	.where(eq(comments.postId, result.id))
	.orderBy(asc(comments.createdAt))
	.all();

const dateFmt = new Intl.DateTimeFormat(lang, { dateStyle: 'medium' });

const canonicalURL = canonicalFromAstro(Astro.url, site);
const description =
	result.excerpt?.trim() || excerptFromContent(result.content);
const ogImage = result.coverImageUrl
	? absoluteUrl(result.coverImageUrl, site)
	: undefined;

const alternates: HreflangAlternates = {
	[lang]: canonicalURL,
};

if (result.translationGroupId != null) {
	const sibling = await db
		.select({
			slug: posts.slug,
			language: posts.language,
		})
		.from(posts)
		.where(
			and(
				eq(posts.translationGroupId, result.translationGroupId),
				ne(posts.language, lang),
				eq(posts.isPublished, true),
			),
		)
		.get();

	if (sibling && isLang(sibling.language)) {
		const siblingLang = sibling.language as Lang;
		alternates[siblingLang] = absoluteUrl(
			`/${siblingLang}/blog/${sibling.slug}`,
			site,
		);
	}
}

const jsonLd = blogPostingJsonLd({
	headline: result.title,
	description,
	image: ogImage,
	datePublished: result.createdAt,
	dateModified: result.updatedAt,
	inLanguage: lang,
	canonicalUrl: canonicalURL,
	authorName: result.authorName,
});

const articleType: ArticleType = 'article';
---

<BaseLayout
	lang={lang}
	title={result.title}
	description={description}
	image={ogImage}
	canonicalURL={canonicalURL}
	articleType={articleType}
	alternates={alternates}
	jsonLd={jsonLd}
>
	<div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[160px_minmax(0,1fr)_160px] xl:grid-cols-[180px_minmax(0,1fr)_180px]">
		<aside class="hidden lg:block">
			<div
				class="sticky top-24 flex h-64 items-center justify-center rounded-xl border border-dashed border-slate-200 bg-white/50 px-3 text-center text-xs font-medium text-slate-400"
			>
				{copy.adSpace}
			</div>
		</aside>

		<div class="mx-auto w-full max-w-3xl">
			<article>
				<a
					href={`/${lang}`}
					class="text-sm text-slate-500 transition-colors hover:text-slate-900"
				>
					← {copy.backHome}
				</a>

				{
					result.coverImageUrl && (
						<Image
							src={result.coverImageUrl}
							alt={result.title}
							width={1200}
							height={600}
							loading="eager"
							fetchpriority="high"
							class="mt-6 aspect-[2/1] w-full rounded-2xl object-cover shadow-sm"
						/>
					)
				}

				<header class="mt-6">
					<h1
						class="bg-gradient-to-r from-slate-900 via-blue-800 to-violet-700 bg-clip-text pb-1 text-4xl font-bold leading-[1.15] tracking-tight text-transparent sm:text-5xl sm:leading-[1.12]"
					>
						{result.title}
					</h1>
					<p class="mt-4 text-sm text-slate-500">
						{copy.byAuthor} {result.authorName}
						{
							date && (
								<>
									{' · '}
									<time datetime={result.createdAt?.toISOString()}>{date}</time>
								</>
							)
						}
					</p>
				</header>

				<div
					class="prose prose-lg prose-slate mt-10 max-w-none leading-relaxed prose-headings:tracking-tight"
					set:html={htmlContent}
				/>
			</article>

			<div class="mt-12">
				<AuthorBox
					lang={lang}
					author={{
						name: result.authorName,
						bio: result.authorBio,
						avatarUrl: result.authorAvatarUrl,
						roleName: result.authorRoleName,
						socialLinks: result.authorSocialLinks,
					}}
				/>
			</div>

			<section class="mt-12">
				<h2 class="text-lg font-semibold tracking-tight text-slate-900">
					{copy.commentsHeading}
				</h2>

				{
					authUser ? (
						<form
							id="comment-form"
							class="mt-4 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm"
							data-post-id={result.id}
							data-login-url={`/${lang}/login`}
						>
							<label for="comment" class="sr-only">
								{copy.commentPlaceholder}
							</label>
							<textarea
								id="comment"
								name="comment"
								rows="4"
								required
								placeholder={copy.commentPlaceholder}
								class="w-full resize-y rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 focus:border-slate-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-200"
							/>
							<p
								id="comment-error"
								class="mt-2 hidden text-sm text-red-600"
								data-default={copy.commentError}
								role="alert"
							/>
							<div class="mt-3 flex justify-end">
								<button
									type="submit"
									class="rounded-full bg-slate-900 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-800"
								>
									{copy.commentSubmit}
								</button>
							</div>
						</form>
					) : (
						<p class="mt-4 rounded-2xl border border-slate-100 bg-white p-5 text-sm text-slate-600 shadow-sm">
							<a
								href={`/${lang}/login`}
								class="font-medium text-slate-900 underline-offset-2 hover:underline"
							>
								{copy.logIn}
							</a>
							{' — '}
							{copy.commentLoginPrompt}
						</p>
					)
				}

				<ul class="mt-6 space-y-4">
					{
						postComments.map((comment) => (
							<li class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
								<div class="flex items-center gap-3">
									{comment.avatarUrl ? (
										<Image
											src={comment.avatarUrl}
											alt={comment.name}
											width={36}
											height={36}
											loading="lazy"
											class="h-9 w-9 rounded-full object-cover"
										/>
									) : (
										<div class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-slate-200 to-blue-100 text-sm font-semibold text-slate-600">
											{comment.name.charAt(0)}
										</div>
									)}
									<div>
										<p class="text-sm font-semibold text-slate-900">{comment.name}</p>
										<p class="text-xs text-slate-400">
											{comment.createdAt
												? dateFmt.format(comment.createdAt)
												: ''}
										</p>
									</div>
								</div>
								<p class="mt-3 text-sm leading-relaxed text-slate-600">
									{comment.content}
								</p>
							</li>
						))
					}
				</ul>
			</section>
		</div>

		<aside class="hidden lg:block">
			<div
				class="sticky top-24 flex h-64 items-center justify-center rounded-xl border border-dashed border-slate-200 bg-white/50 px-3 text-center text-xs font-medium text-slate-400"
			>
				{copy.adSpace}
			</div>
		</aside>
	</div>
</BaseLayout>

{
	authUser && (
		<script>
			const form = document.getElementById('comment-form');
			if (form instanceof HTMLFormElement) {
				form.addEventListener('submit', async (event) => {
					event.preventDefault();

					const errorEl = document.getElementById('comment-error');
					const textarea = form.querySelector('#comment');
					if (!(textarea instanceof HTMLTextAreaElement)) return;

					const postId = Number(form.dataset.postId);
					const content = textarea.value.trim();
					const loginUrl = form.dataset.loginUrl || '/es/login';

					if (errorEl) {
						errorEl.classList.add('hidden');
						errorEl.textContent = '';
					}

					if (!content || !Number.isInteger(postId) || postId <= 0) return;

					try {
						const res = await fetch('/api/comments', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							credentials: 'include',
							body: JSON.stringify({ postId, content }),
						});

						if (res.status === 401) {
							window.location.href = loginUrl;
							return;
						}

						const payload = await res.json().catch(() => ({}));

						if (!res.ok || !payload.ok) {
							if (errorEl) {
								errorEl.textContent =
									errorEl.dataset.default ||
									'Could not post the comment. Please try again.';
								errorEl.classList.remove('hidden');
							}
							return;
						}

						window.location.reload();
					} catch {
						if (errorEl) {
							errorEl.textContent =
								errorEl.dataset.default ||
								'Could not post the comment. Please try again.';
							errorEl.classList.remove('hidden');
						}
					}
				});
			}
		</script>
	)
}
