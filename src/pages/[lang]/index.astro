---
import { desc, eq, and } from 'drizzle-orm';
import PostCard from '../../components/PostCard.astro';
import { db } from '../../db';
import { posts } from '../../db/schema';
import { isLang, t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { lang: langParam } = Astro.params;

if (!langParam || !isLang(langParam)) {
	return Astro.redirect('/es');
}

const lang = langParam;
const copy = t(lang);

const publishedPosts = await db
	.select({
		title: posts.title,
		slug: posts.slug,
		createdAt: posts.createdAt,
		coverImageUrl: posts.coverImageUrl,
	})
	.from(posts)
	.where(and(eq(posts.language, lang), eq(posts.isPublished, true)))
	.orderBy(desc(posts.createdAt));
---

<BaseLayout lang={lang} title={copy.homeTitle} description={copy.homeSubtitle}>
	<section class="mx-auto max-w-6xl">
		<header class="max-w-2xl">
			<h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
				{copy.homeTitle}
			</h1>
			<p class="mt-2 text-lg text-slate-600">{copy.homeSubtitle}</p>
		</header>

		<div class="mt-10">
			<h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
				{copy.postsHeading}
			</h2>
			{
				publishedPosts.length === 0 ? (
					<p class="mt-4 text-slate-600">{copy.noPosts}</p>
				) : (
					<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{publishedPosts.map((post) => (
							<PostCard lang={lang} post={post} />
						))}
					</div>
				)
			}
		</div>
	</section>
</BaseLayout>
