---
import { isLang, t } from '../../i18n/ui';
import { getAuthUser } from '../../lib/auth';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { lang: langParam } = Astro.params;

if (!langParam || !isLang(langParam)) {
	return Astro.redirect('/es/join');
}

const lang = langParam;
const copy = t(lang);
const user = await getAuthUser(Astro.cookies);

if (user) {
	return Astro.redirect(`/${lang}`);
}
---

<BaseLayout lang={lang} title={copy.joinTitle}>
	<section class="mx-auto w-full max-w-md">
		<div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
			<h1 class="text-2xl font-bold tracking-tight text-slate-900">
				{copy.joinTitle}
			</h1>

			<form id="join-form" class="mt-6 space-y-4" novalidate>
				<div>
					<label
						for="name"
						class="mb-1.5 block text-sm font-medium text-slate-700"
					>
						{copy.nameLabel}
					</label>
					<input
						id="name"
						name="name"
						type="text"
						autocomplete="name"
						required
						class="w-full rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-slate-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-200"
					/>
				</div>

				<div>
					<label
						for="email"
						class="mb-1.5 block text-sm font-medium text-slate-700"
					>
						{copy.emailLabel}
					</label>
					<input
						id="email"
						name="email"
						type="email"
						autocomplete="email"
						required
						class="w-full rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-slate-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-200"
					/>
				</div>

				<div>
					<label
						for="password"
						class="mb-1.5 block text-sm font-medium text-slate-700"
					>
						{copy.passwordLabel}
					</label>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="new-password"
						required
						minlength="8"
						class="w-full rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-slate-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-200"
					/>
				</div>

				<p
					id="join-error"
					class="hidden text-sm text-red-600"
					role="alert"
					data-default={copy.joinError}
					data-email-taken={copy.emailTaken}
					data-password-short={copy.passwordTooShort}
					data-invalid={copy.invalidInput}
				>
				</p>

				<button
					type="submit"
					class="w-full rounded-full bg-slate-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-800"
				>
					{copy.joinSubmit}
				</button>
			</form>

			<p class="mt-6 text-center text-sm text-slate-500">
				{copy.joinHint}{' '}
				<a
					href={`/${lang}/login`}
					class="font-medium text-slate-800 underline-offset-2 hover:underline"
				>
					{copy.logIn}
				</a>
			</p>
		</div>
	</section>
</BaseLayout>

<script define:vars={{ lang }}>
	const form = document.getElementById('join-form');
	const errorEl = document.getElementById('join-error');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!errorEl) return;

		errorEl.classList.add('hidden');
		errorEl.textContent = '';

		const data = new FormData(form);
		const name = String(data.get('name') || '');
		const email = String(data.get('email') || '');
		const password = String(data.get('password') || '');

		try {
			const res = await fetch('/api/auth/register', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				credentials: 'include',
				body: JSON.stringify({ name, email, password }),
			});

			const payload = await res.json().catch(() => ({}));

			if (!res.ok || !payload.ok) {
				const code = payload.error;
				let message = errorEl.dataset.default || 'Could not create account.';
				if (code === 'email_taken') {
					message = errorEl.dataset.emailTaken || message;
				} else if (code === 'password_too_short') {
					message = errorEl.dataset.passwordShort || message;
				} else if (code === 'invalid_input' || code === 'invalid_json') {
					message = errorEl.dataset.invalid || message;
				}
				errorEl.textContent = message;
				errorEl.classList.remove('hidden');
				return;
			}

			window.location.href = `/${lang}`;
		} catch {
			errorEl.textContent =
				errorEl.dataset.default || 'Could not create account.';
			errorEl.classList.remove('hidden');
		}
	});
</script>
