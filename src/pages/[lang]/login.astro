---
import { isLang, t } from '../../i18n/ui';
import { getAuthUser, safeAdminNext } from '../../lib/auth';
import { pageAlternates } from '../../lib/seo';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { lang: langParam } = Astro.params;

if (!langParam || !isLang(langParam)) {
	return Astro.redirect('/es/login');
}

const lang = langParam;
const copy = t(lang);
const user = await getAuthUser(Astro.cookies);
const alternates = pageAlternates(lang, '/login', Astro.site);
const nextAfterLogin = safeAdminNext(Astro.url.searchParams.get('next'));

if (user) {
	const dest =
		user.roleName === 'admin' && nextAfterLogin
			? nextAfterLogin
			: `/${lang}`;
	return Astro.redirect(dest);
}
---

<BaseLayout
	lang={lang}
	title={copy.loginTitle}
	alternates={alternates}
	noindex={true}
>
	<section class="mx-auto w-full max-w-md">
		<div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
			<h1 class="text-2xl font-bold tracking-tight text-slate-900">
				{copy.loginTitle}
			</h1>

			<form id="login-form" class="mt-6 space-y-4" novalidate>
				<div>
					<label
						for="email"
						class="mb-1.5 block text-sm font-medium text-slate-700"
					>
						{copy.emailLabel}
					</label>
					<input
						id="email"
						name="email"
						type="email"
						autocomplete="email"
						required
						class="w-full rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-slate-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-200"
					/>
				</div>

				<div>
					<label
						for="password"
						class="mb-1.5 block text-sm font-medium text-slate-700"
					>
						{copy.passwordLabel}
					</label>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="current-password"
						required
						minlength="8"
						class="w-full rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-slate-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-200"
					/>
				</div>

				<p
					id="login-error"
					class="hidden text-sm text-red-600"
					role="alert"
					data-default={copy.loginError}
				>
				</p>

				<button
					type="submit"
					class="w-full rounded-full bg-slate-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-800"
				>
					{copy.loginSubmit}
				</button>
			</form>

			<p class="mt-6 text-center text-sm text-slate-500">
				{copy.loginHint}{' '}
				<a
					href={`/${lang}/join`}
					class="font-medium text-slate-800 underline-offset-2 hover:underline"
				>
					{copy.join}
				</a>
			</p>
		</div>
	</section>
</BaseLayout>

<script define:vars={{ lang, nextAfterLogin }}>
	const form = document.getElementById('login-form');
	const errorEl = document.getElementById('login-error');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!errorEl) return;

		errorEl.classList.add('hidden');
		errorEl.textContent = '';

		const data = new FormData(form);
		const email = String(data.get('email') || '');
		const password = String(data.get('password') || '');

		try {
			const res = await fetch('/api/auth/login', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				credentials: 'include',
				body: JSON.stringify({ email, password }),
			});

			const payload = await res.json().catch(() => ({}));

			if (!res.ok || !payload.ok) {
				errorEl.textContent =
					errorEl.dataset.default || 'Invalid email or password.';
				errorEl.classList.remove('hidden');
				return;
			}

			window.location.href = nextAfterLogin || `/${lang}`;
		} catch {
			errorEl.textContent =
				errorEl.dataset.default || 'Invalid email or password.';
			errorEl.classList.remove('hidden');
		}
	});
</script>
