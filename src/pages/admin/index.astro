---
import { count, eq } from 'drizzle-orm';
import { db } from '../../db';
import { posts, users } from '../../db/schema';
import { getAuthUser } from '../../lib/auth';
import AdminLayout from '../../layouts/AdminLayout.astro';

const user = await getAuthUser(Astro.cookies);
if (!user) {
	return Astro.redirect('/es/login?next=/admin');
}
if (user.roleName !== 'admin') {
	return Astro.redirect('/es');
}

const [totals] = await db.select({ total: count() }).from(posts);
const [published] = await db
	.select({ total: count() })
	.from(posts)
	.where(eq(posts.isPublished, true));
const [drafts] = await db
	.select({ total: count() })
	.from(posts)
	.where(eq(posts.isPublished, false));
const [userTotals] = await db.select({ total: count() }).from(users);

const stats = [
	{
		label: 'Total posts',
		value: totals?.total ?? 0,
		hint: 'Todos los idiomas',
	},
	{
		label: 'Publicados',
		value: published?.total ?? 0,
		hint: 'Visibles en el blog',
	},
	{
		label: 'Borradores',
		value: drafts?.total ?? 0,
		hint: 'Sin publicar',
	},
	{
		label: 'Usuarios',
		value: userTotals?.total ?? 0,
		hint: 'Cuentas registradas',
	},
];
---

<AdminLayout title="Dashboard" user={user}>
	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
		{
			stats.map((stat) => (
				<div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
					<p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
						{stat.label}
					</p>
					<p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
						{stat.value}
					</p>
					<p class="mt-1 text-sm text-slate-500">{stat.hint}</p>
				</div>
			))
		}
	</div>

	<div class="mt-8 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
		<h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">
			Acciones rápidas
		</h2>
		<div class="mt-4 flex flex-wrap gap-3">
			<a
				href="/admin/posts/new"
				class="rounded-full bg-slate-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-800"
			>
				Nuevo post
			</a>
			<a
				href="/admin/posts"
				class="rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 transition-colors hover:border-slate-300 hover:bg-slate-50"
			>
				Ver todos los posts
			</a>
			<a
				href="/admin/users/new"
				class="rounded-full bg-slate-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-800"
			>
				Nuevo usuario
			</a>
			<a
				href="/admin/users"
				class="rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 transition-colors hover:border-slate-300 hover:bg-slate-50"
			>
				Ver usuarios
			</a>
		</div>
	</div>
</AdminLayout>
